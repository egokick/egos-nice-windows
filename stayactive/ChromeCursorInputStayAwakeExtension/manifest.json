{
  "manifest_version": 3,
  "name": "StayActive Chrome Cursor Input Stay Awake",
  "version": "1.5.0",
  "description": "Keeps one supported Chrome remote-session tab awake with bounded cursor and keyboard pulses.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
