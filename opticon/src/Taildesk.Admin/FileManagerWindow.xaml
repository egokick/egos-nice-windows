<Window x:Class="Taildesk.Admin.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opticon Files" Icon="pack://application:,,,/opticon.ico" Width="980" Height="650" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="210" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="ROOT" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,9,0" />
            <ComboBox x:Name="RootCombo" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="RootCombo_SelectionChanged" />
            <Button Grid.Column="2" Margin="9,0,0,0" Content="Up" Click="Up_Click" />
            <TextBox x:Name="PathText" Grid.Column="3" Margin="9,0,9,0" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" />
            <Button Grid.Column="4" Content="Refresh" Click="Refresh_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <Button Content="Download" Style="{StaticResource PrimaryButton}" Click="Download_Click" />
            <Button Content="Upload" Margin="7,0,0,0" Click="Upload_Click" />
            <Button Content="Open / stream" Margin="7,0,0,0" Click="Open_Click" />
            <Button Content="New folder" Margin="7,0,0,0" Click="NewFolder_Click" />
            <Button Content="Delete" Margin="7,0,0,0" Style="{StaticResource DangerButton}" Click="Delete_Click" />
            <Button Content="Cancel operation" Margin="16,0,0,0" Click="Cancel_Click" />
        </StackPanel>

        <DataGrid x:Name="FileGrid" Grid.Row="2" IsReadOnly="True" MouseDoubleClick="FileGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="3*" />
                <DataGridCheckBoxColumn Header="FOLDER" Binding="{Binding IsDirectory}" Width="75" />
                <DataGridTextColumn Header="SIZE" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="110" />
                <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastWriteTime, StringFormat={}{0:g}}" Width="170" />
                <DataGridTextColumn Header="PATH" Binding="{Binding RelativePath}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="DeviceText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono,Consolas" />
        </Grid>
    </Grid>
</Window>
