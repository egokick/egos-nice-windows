<Window x:Class="Taildesk.Admin.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opticon Agent update" Width="620" Height="430" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetText" FontSize="18" FontWeight="SemiBold" />
        <ProgressBar Grid.Row="1" Height="7" Margin="0,16,0,14" IsIndeterminate="True" />
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" />
        <ListBox x:Name="ProgressList" Grid.Row="3" ItemsSource="{Binding UpdateProgressLines}"
                 Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                 FontFamily="Cascadia Mono,Consolas" FontSize="11" Padding="8"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Text="Keep this command center open. Opticon will show a final success, rollback, or detailed failure message." />
    </Grid>
</Window>
